{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/operations.js": { "includeFiles": "{api/_lib/mailing-defaults/*.pdf,public/fonts/poppins/*.ttf,public/images/jeexpert-content/logo-pdf.png}" }
  },
  "headers": [
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/manifest.webmanifest", "headers": [{ "key": "Content-Type", "value": "application/manifest+json" }, { "key": "Cache-Control", "value": "no-cache" }] }
  ],
  "rewrites": [
    { "source": "/api/recruitment", "destination": "/api/operations?__route=recruitment" },
    { "source": "/api/mailing", "destination": "/api/operations?__route=mailing" },
    { "source": "/api/documents-workspace", "destination": "/api/operations?__route=documents-workspace" },
    { "source": "/api/prospection", "destination": "/api/operations?__route=prospection" },
    { "source": "/api/education", "destination": "/api/operations?__route=education" },
    { "source": "/api/applications", "destination": "/api/operations?__route=applications" },
    { "source": "/api/admission-documents", "destination": "/api/operations?__route=admission-documents" },
    { "source": "/api/integration", "destination": "/api/operations?__route=integration" },
    { "source": "/api/notes", "destination": "/api/operations?__route=notes" },
    {
      "source": "/api/at-content/:path*",
      "destination": "/api/proxy?__p=:path*&__host=content"
    },
    { "source": "/api/airtable/:path*", "destination": "/api/proxy?__p=:path*" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
