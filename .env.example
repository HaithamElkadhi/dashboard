# Airtable Personal Access Token (server-side only, injected by the Vite dev proxy)
AIRTABLE_API_KEY=your_airtable_pat_here

# Optional separate PAT for auth base appVHjUwJBU3wGrOW (records read + write).
# Falls back to AIRTABLE_API_KEY when omitted. Never use a VITE_ prefix.
AIRTABLE_AUTH_TOKEN=
# Production canonical origin, e.g. https://your-dashboard.vercel.app
APP_ORIGIN=

# Resend (server-side only) — required for "Send email" in Operations tools
# (e.g. Proposal — Italy). Get a key at https://resend.com/api-keys.
RESEND_API_KEY=your_resend_api_key_here
# Optional — sender address; must be on a domain verified in Resend.
# Falls back to Resend's shared sandbox sender if unset (fine for testing,
# not for real delivery to arbitrary recipients).
RESEND_FROM=onboarding@resend.dev
# Optional — contact sender for Booking emails (meeting link / rappel).
# Falls back to RESEND_FROM if unset.
RESEND_FROM_CONTACT=onboarding@resend.dev
